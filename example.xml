<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:sbol="http://sbols.org/v2#">

  <!-- Define sequence -->
  <sbol:Sequence rdf:about="http://example.org/seq1">
    <sbol:elements>ATGCGTACGTAGCTAG</sbol:elements>
  </sbol:Sequence>

  <!-- Reference sequence from component -->
  <sbol:ComponentDefinition rdf:about="http://example.org/comp1">
    <sbol:sequence rdf:resource="http://example.org/seq1"/>
  </sbol:ComponentDefinition>

</rdf:RDF>